{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "electron.vite.config.*"
  ]
}
